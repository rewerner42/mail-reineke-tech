  .kontakt .c { font-size: 9pt; line-height: 1.55; }
  .absender p { font-size: 8.5pt; line-height: 1.5; color: var(--ink-2); margin-top: 1.2mm; }
  .absender a.unterstr { color: var(--ink); }
  .absender .pflicht { margin-top: 3mm; padding-top: 2mm; border-top: .2mm solid var(--linie); color: var(--ink-2); }
  .logo-voll { display: block; width: 15mm; height: auto; margin-top: .6mm; }

  /* ---------- Anhang ---------- */
  .az { border-top: .2mm solid var(--haar); padding: 1.8mm 0 2mm; align-items: baseline; }
  .az.erst { border-top: .35mm solid var(--ink); }
  .az b { font-size: 9pt; }
  .az .t { font-size: 8.5pt; line-height: 1.4; color: var(--ink-2); }
  .az .g { font-size: 8pt; line-height: 1.4; color: var(--ink-3); }
  .az .nb { font-size: 11pt; line-height: 1.1; font-weight: 700; }
  .az .sc { margin-left: 2mm; }
  .az .mono.wert { color: var(--ink-2); font-size: 7.2pt; }
  .az.sub { border-top: .2mm solid var(--haar-2); padding: 1.5mm 0 1.7mm; }
  .az.sub .t { font-size: 8pt; line-height: 1.38; }
  .az .eingerueckt { padding-left: 4mm; }
  .gruppe-kopf { border-top: .35mm solid var(--ink); padding-top: 2.2mm; margin-top: 4mm; }
  .gruppe-kopf.erst { margin-top: 0; }
  .gruppe-kopf + .az { border-top: 0; }
  .az .g.pr { font-size: 7.5pt; }
</style>
</head>
<body>
{#- ---------------- Seitenplanung ----------------
    Feste Kapitelfolge: Deckblatt, 01 Zusammenfassung, 02 Empfehlungen (Penetrationstest darunter oder auf eigener
    Seite), 03 Über uns, 04 Nächster Schritt, 05 Feststellungen (hoch/mittel, danach geringe Feststellungen und bereits
    Umgesetztes), Anhang A (Messwerte), Anhang B (Methodik, Notenskala).
    Umbrüche werden vorab berechnet: Jeder Block bekommt eine geschätzte Höhe in mm (Zeichen pro Zeile je
    Spaltenbreite, aufgerundet, kalibriert mit Messungen im Browser, eher zu hoch als zu niedrig).
    Der Satzspiegel einer Seite ist 242 mm (297 mm minus 31 mm oben und 24 mm unten).
    - Feststellungen hoch/mittel: höchstens 3 je Seite, weniger, wenn die Schätzung nicht passt.
    - Geringe Feststellungen und „Bereits umgesetzt“: eine Seite, bei Überlänge „Bereits umgesetzt“ auf einer Folgeseite.
    - Block „Penetrationstest“ (91 mm): unter den Empfehlungen, sonst auf eigener Seite direkt danach.
    - Anhang A: Bereich Website bei vielen Observatory-Tests geschlossen auf einer Folgeseite. -#}
{% set SATZSPIEGEL = 242 %}
{# Pentest-Kasten samt Abstand gemessen 89,7 mm (30.10.); die Tabellenschätzung liegt in allen 20 Testläufen 0,5–7,4 mm über der Ist-Höhe #}
{% set PENTEST = 90 %}
{% set VORSPANN_EMP = 8 %}
{% set KOPF02 = 30 %}
{% set haupt = nach_prio.hoch + nach_prio.mittel %}

{# Kapitel 05: Feststellungen hoch und mittel #}
{% set fp = namespace(seiten=[], akt=[], h=0) %}
{% for f in haupt %}
  {% set l1 = ((f.feststellung|length) / 33)|round(0, 'ceil') %}
  {% set l2 = ((f.angriff|length) / 33)|round(0, 'ceil') %}
  {% set l3 = ((f.auswirkung|length) / 31)|round(0, 'ceil') + ((f.aufwand|length + f.aufwand_text|length + 2) / 33)|round(0, 'ceil') %}
  {% set hf = 24 + 5.7 * (((f.titel|length) / 48)|round(0, 'ceil') - 1) + [4.5 * l1, 4.5 * l2, 4.5 * l3 + 7.3]|max + 3.2 + 3.6 * ((f.tech|length) / 80)|round(0, 'ceil') %}
  {% set budget = SATZSPIEGEL - (KOPF02 if not fp.seiten else 0) %}
  {% if fp.akt and (fp.akt|length == 3 or fp.h + 7 + hf > budget) %}
    {% set fp.seiten = fp.seiten + [fp.akt] %}
    {% set fp.akt = [] %}
    {% set fp.h = 0 %}
  {% endif %}
  {% set fp.h = fp.h + (7 if fp.akt else 0) + hf %}
  {% set fp.akt = fp.akt + [f] %}
{% endfor %}
{% if fp.akt %}{% set fp.seiten = fp.seiten + [fp.akt] %}{% endif %}
{% set fseiten = fp.seiten %}

{# Kapitel 05: geringe Feststellungen und bereits Umgesetztes #}
{% set weitere = nach_prio.gering or positiv or not haupt %}
{% set hw = namespace(g=0, p=0) %}
{% if nach_prio.gering %}
  {% set hw.g = 16.5 %}
  {% for f in nach_prio.gering %}
    {% set hw.g = hw.g + 6 + 4.4 * (((f.titel|length) / 70)|round(0, 'ceil') + ((f.kurz|length) / 74)|round(0, 'ceil') + ((f.aufwand_text|length + 16) / 84)|round(0, 'ceil')) %}
  {% endfor %}
{% endif %}
{% if positiv %}
  {% set hw.p = 16.5 + 5.2 * ((positiv_einleitung|length) / 70)|round(0, 'ceil') %}
  {% for x in positiv %}{% set hw.p = hw.p + 8.8 + 4.7 * (((x.text|length) / 66)|round(0, 'ceil') - 1) %}{% endfor %}
{% endif %}
{% set hw_kopf = (15.5 if not haupt else 0) + (12 if not feststellungen else 0) %}
{% set w_split = hw_kopf + hw.g + hw.p > SATZSPIEGEL %}

{# Kapitel 02: Empfehlungen (24,4 mm Kopf, einzeiliger Vorspann mit Verweis auf Kapitel 05) #}
{% set hs = namespace(emp=24.4 + (VORSPANN_EMP if feststellungen else 0)) %}
{% for m in massnahmen %}
  {% set tl = ((m.text|length) / 56)|round(0, 'ceil') + ((m.titel|length) / 52)|round(0, 'ceil') - 1 %}
  {% set bl = ((m.bezug|length + 1) / 3)|round(0, 'ceil') if m.bezug else 1 %}
  {% set hs.emp = hs.emp + [11.3 + 4.3 * tl, 9.9 + 3.95 * bl]|max %}
{% endfor %}
{% set pt_emp = hs.emp + PENTEST <= SATZSPIEGEL %}
{% set pt_wei = false %}
{% set pt_eigen = not pt_emp and not pt_wei %}

{# Anhang A: Messwerte #}
{% set mh = namespace(h=121 + (4.2 if technik.dmarc.record and technik.dmarc.record|length > 56 else 0)) %}
{% for x in technik.observatory.tests %}
  {% set mh.h = mh.h + 3.8 + 3.9 * (((x.result_text|length) / 58)|round(0, 'ceil') + ((x.recommendation|length + 12) / 58)|round(0, 'ceil')) %}
{% endfor %}
{% set web_extra = mh.h > SATZSPIEGEL - 3 %}

{% set N = 3 + fseiten|length + (1 if weitere else 0) + (1 if w_split else 0) + 1 + (1 if pt_eigen else 0) + 1 + 1 + 2 + (1 if web_extra else 0) %}
{# Seiten von Kapitel 05 für die Verweise aus Inhalt, Zusammenfassung und Empfehlungen:
   Seite 2 Inhalt, 3 Zusammenfassung, 4 Empfehlungen (+1 Penetrationstest), dann Über uns, Nächster Schritt, dann Kapitel 05. #}
{% set F_START = 7 + (1 if pt_eigen else 0) %}
{% set FS = {} %}
{% for chunk in fseiten %}{% set ci = loop.index %}{% for f in chunk %}{% set _x = FS.update({f.nr: F_START + ci - 1}) %}{% endfor %}{% endfor %}
{% for f in nach_prio.gering %}{% set _x = FS.update({f.nr: F_START + fseiten|length}) %}{% endfor %}
{# Seiten der Kapitel für das Inhaltsverzeichnis #}
{% set P_ZF = 3 %}{% set P_EMP = 4 %}{% set P_PT = P_EMP + (1 if pt_eigen else 0) %}
{% set P_UEBER = F_START - 2 %}{% set P_NEXT = F_START - 1 %}
{% set P_UMGESETZT = F_START + fseiten|length + (1 if w_split else 0) %}
{% set P_ANH_A = F_START + fseiten|length + (1 if weitere else 0) + (1 if w_split else 0) %}
{% set P_ANH_B = P_ANH_A + 1 + (1 if web_extra else 0) %}
{% set ns = namespace(p=1) %}
{% set lvl = level.key %}
{# Bedeutung der Stufe in einem Satz (gleiche Texte wie in v12) #}
{% set HB_HEISST = {'gering': 'Einzelne Punkte bei Gelegenheit verbessern.', 'mittel': 'Verbesserungen fest einplanen.',
                    'hoch': 'Lücken zeitnah schließen.', 'kritisch': 'Lücken vorrangig schließen.'} %}

{% macro kopf(kap) -%}
<div class="kopf">
  <div class="k-marke"><span class="fuchs"><img src="{{ logo }}" alt=""></span><b>{{ firma.kurzname }}</b><span>Sicherheitsbefund</span></div>
  <div class="k-domain">{{ domain }}</div>
  <div class="k-kap">{{ kap }}</div>
</div>
{%- endmacro %}
{% macro fuss(n) -%}
<div class="fuss"><span class="f1">{{ firma.name }} · Vertraulich</span><span class="f2">Bericht-Nr. {{ bericht_nr }}</span><span class="f3">Seite {{ n }} von {{ N }}</span></div>
{%- endmacro %}
{% macro note(n) -%}
<span>{{ n[:1] }}</span>{% if n|length > 1 %}<span class="mod">{{ n[1:]|minus }}</span>{% endif %}
{%- endmacro %}
{% macro befund(f, erst) -%}
<article class="bf{% if erst %} erst{% endif %}" id="{{ f.nr }}">
  <div class="r6 bf-kopf">
    <div class="s12 bf-nr">{{ f.nr }}</div>
    <h2 class="s36">{{ f.titel }}</h2>
  </div>
  <div class="r6 bf-meta">
    <div class="s12"><span class="prio {{ f.prio }}">{{ f.prio_label }}</span></div>
    <div class="s36 bf-fach">{{ f.bereich_label }} · {{ f.fach }} · <a href="#{{ f.massnahme_nr }}">Maßnahme {{ f.massnahme_nr }}</a></div>
  </div>
  <div class="r6 bf-text">
    <div class="s12"><span class="label">Feststellung</span><p>{{ f.feststellung }}</p></div>
    <div class="s34"><span class="label">Angriffsszenario</span><p>{{ f.angriff }}</p></div>
    <div class="s56"><span class="label">Auswirkung für Sie</span><p class="wirk">{{ f.auswirkung }}</p>
      <span class="label">Aufwand</span><p>{{ f.aufwand|capitalize }}. {{ f.aufwand_text }}</p></div>
  </div>
  <div class="r6 bf-tech">
    <div class="s12"><span class="label">Technischer Befund</span></div>
    <div class="s36 mono">{{ f.tech }}</div>
  </div>
</article>
{%- endmacro %}

{% macro umgesetzt_block(abstand) -%}
<div class="r6 {{ abstand }} linie umgesetzt" id="umgesetzt">
  <div class="s12"><span class="prio ok">Bereits umgesetzt</span><div class="zahl">{{ positiv|length }}</div><span class="klein">{{ 'Punkt' if positiv|length == 1 else 'Punkte' }}</span></div>
  <div class="s36">
    <p class="lead-s">{{ positiv_einleitung }}</p>
    <ul class="positiv-liste">{% for x in positiv %}<li>{{ x.text }}</li>{% endfor %}</ul>
  </div>
</div>
{%- endmacro %}
{% macro pentest_block(abstand) -%}
<div class="r6 {{ abstand }} linie pentest" id="pentest">
  <div class="s12">
    <span class="label">Penetrationstest</span>
    <ul class="arten">
      {% for k in firma.pentest_arten %}<li><b>{{ k.titel }}</b><span>{{ k.text }}</span></li>{% endfor %}
    </ul>
  </div>
  <div class="s36">
    <h2>{{ texte.pentest_titel }}</h2>
    <p class="lead-s">{{ texte.pentest_text }}</p>
    <ol class="schritte r2">
      {% for s in texte.pentest_ablauf %}<li><span class="n">{{ loop.index }}</span><span><b>{{ s.titel }}</b>{{ s.text }}</span></li>{% endfor %}
    </ol>
    <p class="klein link">Umfang und Anfrage: <a class="unterstr" href="{{ firma.pentest_url }}">{{ firma.pentest_label }}</a></p>
  </div>
</div>
{%- endmacro %}

{% include "deckblatt.html.j2" %}

{# ================= Inhalt (Seite 2) ================= #}
{% set ns.p = ns.p + 1 %}
<section class="page pg seite-inhalt">
  {{ kopf('Inhalt') }}
  <div class="r6 kk"><div class="nr"></div><h1>Inhalt</h1></div>
  <div class="r6 inh-hinweis"><p class="s36">Für die Geschäftsführung: Kapitel 01 bis 04. Für Ihre IT: Kapitel 05 und der Anhang.</p></div>
  <div class="inh{% if feststellungen|length > 14 %} inh--kompakt{% endif %}">
    <a class="inh-kap" href="#kap-01"><span class="inh-nr">01</span><span class="inh-t">Zusammenfassung</span><span class="inh-s">{{ P_ZF }}</span></a>
    <a class="inh-kap" href="#kap-02"><span class="inh-nr">02</span><span class="inh-t">Empfehlungen</span><span class="inh-s">{{ P_EMP }}</span></a>
    <a class="inh-sub" href="#pentest"><span class="inh-nr"></span><span class="inh-t">{{ texte.pentest_titel }}</span><span class="inh-s">{{ P_PT }}</span></a>
    <a class="inh-kap" href="#kap-03"><span class="inh-nr">03</span><span class="inh-t">Über {{ firma.kurzname }}</span><span class="inh-s">{{ P_UEBER }}</span></a>
    <a class="inh-kap" href="#kap-04"><span class="inh-nr">04</span><span class="inh-t">Nächster Schritt</span><span class="inh-s">{{ P_NEXT }}</span></a>
    <a class="inh-sub" href="#kap-04"><span class="inh-nr"></span><span class="inh-t">{{ texte.cta_titel }}: Termin direkt aus dem Bericht buchen</span><span class="inh-s">{{ P_NEXT }}</span></a>
    <a class="inh-kap" href="#kap-05"><span class="inh-nr">05</span><span class="inh-t">Feststellungen im Einzelnen</span><span class="inh-s">{{ F_START }}</span></a>
    {% for f in feststellungen %}
    <a class="inh-sub" href="#{{ f.nr }}"><span class="inh-nr"><span class="prio {{ f.prio }}"></span>{{ f.nr }}</span><span class="inh-t">{{ f.titel }}</span><span class="inh-s">{{ FS[f.nr] }}</span></a>
    {% endfor %}
    {% if positiv %}
    <a class="inh-sub" href="#umgesetzt"><span class="inh-nr"></span><span class="inh-t">Bereits umgesetzt</span><span class="inh-s">{{ P_UMGESETZT }}</span></a>
    {% endif %}
    <a class="inh-kap" href="#kap-a"><span class="inh-nr">A</span><span class="inh-t">Messwerte</span><span class="inh-s">{{ P_ANH_A }}</span></a>
    <a class="inh-kap" href="#kap-b"><span class="inh-nr">B</span><span class="inh-t">Methodik und Bewertung</span><span class="inh-s">{{ P_ANH_B }}</span></a>
  </div>
  {{ fuss(ns.p) }}
</section>

{# ================= 01 Zusammenfassung ================= #}
{% set ns.p = ns.p + 1 %}
<section class="page pg seite-zf">
  {{ kopf('Zusammenfassung') }}
  <div class="r6 kk" id="kap-01"><div class="nr">01</div><h1>Zusammenfassung</h1></div>

  <div class="r6 urteil lv-{{ lvl }}">
    <div class="s12"><span class="label">Gesamturteil</span><p class="marginalie">{{ texte.methode_kurz }}</p>{% if level.hinweis %}<p class="marginalie hb-hinweis">{{ level.hinweis }}</p>{% endif %}</div>
    <div class="s36">
      <div class="hb">Handlungsbedarf</div>
      <div class="zeile">
        <div class="wort">{{ level.label }}</div>
        <div class="heisst">Das heißt:<b>{{ HB_HEISST[lvl] }}</b></div>
      </div>
      <div class="skala">
        {% for k in ['gering', 'mittel', 'hoch', 'kritisch'] %}<div{% if k == lvl %} class="an"{% endif %}>{{ k|capitalize }}</div>{% endfor %}
      </div>
      <p class="lead">{{ level.satz }}</p>
    </div>
  </div>

  <div class="blk">
    <div class="noten">
      {% for a in bereiche %}
      <div class="nt">
        <span class="label">{{ a.label }} · {{ a.pruefung }}</span>
        <div class="schutz">{{ a.schutzziel }}</div>
        <div class="note {{ a.klasse }}">{{ note(a.note) }}</div>
        <div class="wort {{ a.klasse }}">{{ a.wort }}</div>
        <div class="nt-mini">{% for n in noten %}<span class="{{ n.klasse }}{% if a.note in n.noten %} an{% endif %}">{{ n.noten[0][:1] }}</span>{% endfor %}</div>
        <p class="satz">{{ a.satz }}</p>
        <div class="meta">{% if a.score is not none %}Score {{ a.score }} · {% endif %}{{ a.bedeutung }}</div>
      </div>
      {% endfor %}
    </div>
    <div class="nsk2"><span class="label">Notenskala</span>{% for n in noten %}<span><i class="{{ n.klasse }}"></i><b>{{ n.noten|first|minus }}{% if n.noten|length > 1 %} bis {{ n.noten|last|minus }}{% endif %}</b> {{ n.wort|lower }}</span>{% endfor %}</div>
  </div>

  {% if top %}
  <div class="r6 blk linie top3">
    <div class="s12 zaehler">
      <span class="label">Wesentliche Feststellungen</span>
      <div class="zahl">{{ anzahl.gesamt }}</div>
      <span class="klein">Feststellungen insgesamt</span>
      <ul class="verteilung">
        <li><span class="prio hoch">Hoch</span><b>{{ anzahl.hoch }}</b></li>
        <li><span class="prio mittel">Mittel</span><b>{{ anzahl.mittel }}</b></li>
        <li><span class="prio gering">Gering</span><b>{{ anzahl.gering }}</b></li>
      </ul>
    </div>
    <ol class="s36">
      {% for f in top %}
      <li><span class="fnr">{{ f.nr }}</span><span><a href="#{{ f.nr }}"><b>{{ f.titel }}</b></a><span class="kurz">{{ f.kurz }}</span></span><span class="rechts"><span class="prio {{ f.prio }}">{{ f.prio_label }}</span><a class="seite" href="#{{ f.nr }}">Seite {{ FS[f.nr] }}</a></span></li>
      {% endfor %}
    </ol>
  </div>
  {% endif %}

  <div class="r6 blk linie cta">
    <div class="s12"><span class="label">Nächster Schritt</span><b>{{ texte.cta_titel }}</b></div>
    <p class="s34">{{ texte.cta_text }}</p>
    <div class="s56 cta-knopf"><a class="btn" href="{{ firma.booking_url }}">{{ texte.cta_button }}</a></div>
  </div>
  {{ fuss(ns.p) }}
</section>

{# ================= 02 Empfehlungen und Penetrationstest ================= #}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Empfehlungen') }}
  <div class="r6 kk{% if feststellungen %} kk-mit{% endif %}" id="kap-02"><div class="nr">02</div><h1>Empfehlungen</h1></div>
  {% if feststellungen %}
  <div class="r6 vorspann"><p class="s36">Details zu den Feststellungen: Kapitel 05 ab Seite {{ F_START }}.</p></div>
  {% endif %}
  <div class="r6 kopfzeile">
    <div class="s1"><span class="label">Nr.</span></div>
    <div class="s2"><span class="label">Dringlichkeit</span></div>
    <div class="s35"><span class="label">Maßnahme</span></div>
    <div class="s6"><span class="label">Aufwand</span><span class="label hell">Bezug</span></div>
  </div>
  {% for m in massnahmen %}
  <div class="r6 mz{% if loop.first %} erst{% endif %}" id="{{ m.nr }}">
    <div class="s1 mnr">{{ m.nr }}</div>
    <div class="s2">{% if m.prio %}<span class="prio {{ m.prio }}">{{ m.prio|capitalize }}</span>{% else %}<span class="klein">Abschluss</span>{% endif %}</div>
    <div class="s35"><b>{{ m.titel }}</b><p>{{ m.text }}</p></div>
    <div class="s6"><div class="wert">{{ m.aufwand|capitalize }}</div><div class="bezug">{% if m.bezug %}{% set ps = [] %}{% for b in m.bezug %}{% if FS[b] not in ps %}{% set _x = ps.append(FS[b]) %}{% endif %}<a class="nw" href="#{{ b }}">{{ b }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% set ps = ps|sort %} <span class="seitenref">· S.&nbsp;{% if ps|length > 1 and ps|last - ps|first + 1 == ps|length %}{{ ps|first }}–{{ ps|last }}{% else %}{{ ps|join(', ') }}{% endif %}</span>{% else %}{{ m.bezug_text|capitalize }}{% endif %}</div></div>
  </div>
  {% endfor %}

  {% if pt_emp %}{{ pentest_block('blk') }}{% endif %}
  {{ fuss(ns.p) }}
</section>

{% if pt_eigen %}
{# ---------- Penetrationstest auf eigener Seite (nur bei sehr langen Listen) ---------- #}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Empfehlungen') }}
  {{ pentest_block('') }}
  {{ fuss(ns.p) }}
</section>
{% endif %}

{# ================= 03 Über Reineke Technik ================= #}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Über ' ~ firma.kurzname) }}
  <div class="r6 kk" id="kap-03"><div class="nr">03</div><h1>Über {{ firma.kurzname }}</h1></div>
  <div class="r6 person">
    <div class="s12"><img class="portrait" src="{{ firma.vorstellung.foto_url }}" alt="{{ firma.vorstellung.name }}"></div>
    <div class="s36">
      <div class="p-name">{{ firma.vorstellung.name }}</div>
      <div class="p-rolle">{{ firma.vorstellung.rolle }}</div>
      {% for a in firma.vorstellung.absaetze %}<p class="lead-s">{{ a }}</p>{% endfor %}
    </div>
  </div>
  <div class="r6 blk">
    <p class="s36 zitat">„{% for z in firma.slogan %}{{ z }}{% if not loop.last %}<br>{% endif %}{% endfor %}“</p>
  </div>
  <div class="r3 drei blk">
    {% for p in firma.prinzipien %}<div><h3>{{ p.titel }}</h3><p>{{ p.text }}</p></div>{% endfor %}
  </div>
  <div class="r3 drei blk">
    {% for v in firma.vertrauen %}<div><span class="label">{{ v.label }}</span><div class="v-wert{% if v.wert|length > 14 %} lang{% endif %}">{{ v.wert }}</div><p>{{ v.text }}</p></div>{% endfor %}
  </div>
  <div class="r6 blk linie">
    <div class="s12"><span class="label">Leistungen</span></div>
    <ul class="s36 leist">{% for l in firma.leistungen %}<li>{{ l }}</li>{% endfor %}</ul>
  </div>
  {{ fuss(ns.p) }}
</section>

{# ================= 04 Nächster Schritt ================= #}
{% set ns.p = ns.p + 1 %}
<section class="page pg spalte">
  {{ kopf('Nächster Schritt') }}
  <div class="r6 kk" id="kap-04"><div class="nr">04</div><h1>Nächster Schritt</h1></div>
  <div class="r6 cta-gross">
    <div class="s12"><span class="label">{{ texte.cta_titel }}</span><span class="klein">{{ domain }}</span></div>
    <div class="s34"><p class="lead">{{ texte.cta_text }}</p><a class="btn" href="{{ firma.booking_url }}">{{ texte.cta_button }}</a></div>
    <div class="s56 qr"><a href="{{ firma.booking_url }}"><img src="{{ qr_termin }}" alt="QR-Code zur Terminbuchung"></a><div class="klein">Termin per QR-Code</div></div>
  </div>
  <div class="r3 drei ablauf blk">
    {% for s in texte.ablauf %}<div><span class="label">Schritt</span><div class="gz-n">{{ loop.index }}</div><h3>{{ s.titel }}</h3><p>{{ s.text }}</p></div>{% endfor %}
  </div>
  <div class="r6 blk">
    <div class="s16"><span class="label" style="margin-bottom:2.5mm">Ansprechpartner</span></div>
  </div>
  <div class="r2">
    {% for k in firma.kontakte %}
    <div class="kontakt{% if not k.foto_url %} ohne{% endif %}">
      {% if k.foto_url %}<img src="{{ k.foto_url }}" alt="{{ k.name }}">{% endif %}
      <div><div class="n">{{ k.name }}</div><div class="r">{{ k.rolle }}</div>
        <div class="c"><a href="mailto:{{ k.email }}">{{ k.email }}</a><br><a href="tel:{{ k.telefon_href }}">{{ k.telefon }}</a>{% if k.mobil %}<br><a href="tel:{{ k.mobil_href }}">{{ k.mobil }}</a> (mobil){% endif %}</div></div>
    </div>
    {% endfor %}
  </div>
  <div class="r6 linie absender unten">
    <div class="s12"><img class="logo-voll" src="{{ logo }}" alt="{{ firma.name }}"></div>
    <div class="s34"><span class="label">Anschrift</span><p>{{ firma.name }}<br>{{ firma.strasse }}<br>{{ firma.plz_ort }}<br><a href="{{ firma.web_url }}">{{ firma.web }}</a></p></div>
    <div class="s56"><span class="label">Penetrationstest anfragen</span><p><a class="unterstr" href="{{ firma.pentest_url }}">{{ firma.pentest_label }}</a></p></div>
    {#- Pflichtangaben nach § 35a GmbHG (D22): Registergericht, Registernummer und alle Geschäftsführer. #}
    <p class="s16 klein pflicht">{{ firma.pflichtangaben.registergericht }} · {{ firma.pflichtangaben.hrb }} · Geschäftsführer: {{ firma.pflichtangaben.geschaeftsfuehrer|join(', ') }} · USt-IdNr. {{ firma.pflichtangaben.ust_id }}</p>
  </div>
  {{ fuss(ns.p) }}
</section>

{# ================= 05 Feststellungen: hoch und mittel (Umbruch siehe Seitenplanung) ================= #}
{% for chunk in fseiten %}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Feststellungen') }}
  {% if loop.first %}
  <div class="r6 kk kk-mit" id="kap-05"><div class="nr">05</div><h1>Feststellungen im Einzelnen</h1></div>
  <div class="r6 vorspann"><p class="s36">Zu jeder Feststellung: was wir festgestellt haben, was ein Angreifer damit erreichen kann und was das für Sie bedeutet.</p></div>
  {% endif %}
  {% for f in chunk %}{{ befund(f, loop.first) }}{% endfor %}
  {{ fuss(ns.p) }}
</section>
{% endfor %}

{# ================= 05 Feststellungen: geringe Einstufung und bereits Umgesetztes ================= #}
{% if weitere %}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Feststellungen') }}
  {% if not haupt %}
  <div class="r6 kk" id="kap-05"><div class="nr">05</div><h1>Feststellungen im Einzelnen</h1></div>
  {% endif %}
  {% if nach_prio.gering %}
  <div class="r6 sek"><div class="s12"><span class="prio gering">Gering</span></div><h2 class="s36">Weitere Feststellungen</h2></div>
  {% for f in nach_prio.gering %}
  <div class="r6 gz{% if loop.first %} erst{% endif %}" id="{{ f.nr }}">
    <div class="s12"><span class="fnr">{{ f.nr }}</span><span class="gz-meta">{{ f.bereich_label }} · {{ f.fach }}</span></div>
    <div class="s36"><b>{{ f.titel }}</b><span class="kurz">{{ f.kurz }}</span><span class="auf">Aufwand {{ f.aufwand }}: {{ f.aufwand_text }}</span></div>
  </div>
  {% endfor %}
  <div class="r6"><p class="s36 klein gz-fuss">Technische Einzelwerte zu allen Feststellungen in Anhang A, Maßnahmen in Kapitel 02.</p></div>
  {% endif %}
  {% if not feststellungen %}
  <div class="r6"><p class="s36 lead">In den geprüften Bereichen wurden keine Feststellungen getroffen.</p></div>
  {% endif %}
  {% if positiv and not w_split %}{{ umgesetzt_block('blk') }}{% endif %}
  {{ fuss(ns.p) }}
</section>
{% endif %}
{% if w_split %}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Feststellungen') }}
  {{ umgesetzt_block('') }}
  {{ fuss(ns.p) }}
</section>
{% endif %}

{# ================= Anhang A: Messwerte, nach Bereichen geordnet ================= #}
{% set t = technik %}
{% set k_mail = (bereiche|selectattr('key', 'equalto', 'email')|first).klasse %}
{% set k_dns = (bereiche|selectattr('key', 'equalto', 'domain')|first).klasse %}
{% set k_web = (bereiche|selectattr('key', 'equalto', 'website')|first).klasse %}
{% macro testzeile(x) -%}
<div class="r6 az sub">
  <div class="s12 t eingerueckt">{{ x.label }}</div>
  <div class="s3 t"><b>{{ x.modifier_text }}</b></div>
  <div class="s46 t">{{ x.result_text }}<br><span class="g">Empfehlung: {{ x.recommendation }}</span></div>
</div>
{%- endmacro %}
{% macro webgruppe(erst) -%}
<div class="r6 gruppe-kopf {{ erst }}"><span class="s16 label">Website</span></div>
<div class="r6 az">
  <div class="s12"><b>HTTP Observatory</b></div>
  <div class="s3"><span class="nb {{ k_web }}">{{ t.observatory.note|minus }}</span>{% if t.observatory.score is not none %}<span class="g sc">Score {{ t.observatory.score }}</span>{% endif %}</div>
  <div class="s46 t">{% if t.observatory.available %}{{ t.observatory.passed }} von {{ t.observatory.total }} Tests bestanden{% if t.observatory.tests %}. Tests mit Abzug:{% endif %}{% else %}Test nicht verfügbar{% endif %}</div>
</div>
{% for x in t.observatory.tests %}{{ testzeile(x) }}{% endfor %}
{%- endmacro %}
{% macro mwkopf() -%}
<div class="r6 kopfzeile">
  <div class="s12"><span class="label">Prüfung</span></div>
  <div class="s3"><span class="label">Ergebnis</span></div>
  <div class="s46"><span class="label">Messwert</span></div>
</div>
{%- endmacro %}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Anhang') }}
  <div class="r6 kk" id="kap-a"><div class="nr">A</div><h1>Messwerte</h1></div>
  {{ mwkopf() }}
  <div class="r6 gruppe-kopf erst"><span class="s16 label">E-Mail</span></div>
  <div class="r6 az">
    <div class="s12"><b>DMARC</b></div>
    <div class="s3"><span class="nb {{ k_mail }}">{{ t.dmarc.note|minus }}</span>{% if t.dmarc.score is not none %}<span class="g sc">Score {{ t.dmarc.score }}</span>{% endif %}</div>
    <div class="s46 t">{% if t.dmarc.record %}<span class="mono wert">{{ t.dmarc.record }}</span>{% else %}Kein DMARC-Eintrag veröffentlicht{% endif %}<br><span class="g">Richtlinie (p): {{ t.dmarc.policy if t.dmarc.policy else '–' }} · Berichte (rua): {{ 'angefordert' if t.dmarc.rua else 'nicht angefordert' }}</span></div>
  </div>
  {% for m in t.mail %}
  <div class="r6 az">
    <div class="s12"><b>{{ m.label }}</b></div>
    <div class="s3"><span class="prio {{ m.status }}">{{ m.status_label }}</span></div>
    <div class="s46 t">{{ m.text }}</div>
  </div>
  {% endfor %}
  <div class="r6 gruppe-kopf"><span class="s16 label">Domain</span></div>
  <div class="r6 az">
    <div class="s12"><b>DNSSEC</b></div>
    <div class="s3"><span class="nb {{ k_dns }}">{{ t.dnssec.note|minus }}</span>{% if t.dnssec.score is not none %}<span class="g sc">Score {{ t.dnssec.score }}</span>{% endif %}</div>
    <div class="s46 t">{{ 'Zone signiert' if t.dnssec.signed else 'Zone nicht signiert' }}</div>
  </div>
  {% if not web_extra %}{{ webgruppe('') }}{% endif %}
  {{ fuss(ns.p) }}
</section>
{% if web_extra %}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Anhang') }}
  <div class="r6 sek"><div class="s12"><span class="label">Anhang A</span></div><h2 class="s36">Messwerte, Fortsetzung</h2></div>
  {{ mwkopf() }}
  {{ webgruppe('erst') }}
  {{ fuss(ns.p) }}
</section>
{% endif %}

{# ================= Anhang B: Methodik und Bewertung ================= #}
{% set ns.p = ns.p + 1 %}
<section class="page pg">
  {{ kopf('Anhang') }}
  <div class="r6 kk" id="kap-b"><div class="nr">B</div><h1>Methodik und Bewertung</h1></div>
  <div class="r6">
    <div class="s12"><span class="label">Vorgehen</span></div>
    <p class="s36 lead-s">{{ texte.methode_lang }}</p>
  </div>
  <div class="blk">
    {% for m in texte.methodik %}
    <div class="r6 az{% if loop.first %} erst{% endif %}">
      <div class="s12"><b>{{ m.bereich }}</b><br><span class="g pr">{{ m.pruefung }}</span></div>
      <div class="s36 t">{{ m.text }}</div>
    </div>
    {% endfor %}
  </div>
  <div class="r6 blk" style="margin-bottom:2.5mm"><div class="s16"><span class="label">Notenskala</span></div></div>
  {% for n in noten %}
  <div class="r6 az{% if loop.first %} erst{% endif %}">
    <div class="s12"><span class="nb {{ n.klasse }}">{{ n.noten|join(' / ')|minus }}</span></div>
    <div class="s34"><span class="prio {{ n.klasse }}">{{ n.wort }}</span></div>
    <div class="s56 t">{{ n.bedeutung }}</div>
  </div>
  {% endfor %}
  {% for a in bereiche if a.klasse == 'na' %}{% if loop.first %}
  <div class="r6 az">
    <div class="s12"><span class="nb na">{{ a.note }}</span></div>
    <div class="s34"><span class="prio na">{{ a.wort }}</span></div>
    <div class="s56 t">{{ a.bedeutung }}</div>
  </div>
  {% endif %}{% endfor %}
  <div class="r6 blk"><p class="s36 klein">{{ texte.vertraulich }}</p></div>
  {{ fuss(ns.p) }}
</section>

</body>
</html>
