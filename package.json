{
  "name": "mail-reineke-tech",
  "version": "0.1.0",
  "private": true,
  "description": "Email authentication analyzer (DMARC, DKIM, SPF, MX) for Reineke Technik",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env sharp",
    "deploy": "echo 'Bitte deploy:reineke oder deploy:sharp verwenden. Ein blankes deploy ginge auf den Sharp-Worker.' && exit 1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "deploy:reineke": "wrangler deploy --env reineke",
    "deploy:sharp": "wrangler deploy --env sharp",
    "dev:reineke": "wrangler dev --env reineke"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.1"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "hono": "^4.6.17"
  }
}
